# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret used to sign session JWTs for authentication
JWT_SECRET="nibras_production_jwt_secret_key_change_me_in_prod"

# DATABASE_URL: Database connection URL (for production PostgreSQL / Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/nibras"

# Storage configuration (Amazon S3 / Cloudflare R2 / Google Cloud Storage)
STORAGE_ENDPOINT=""
STORAGE_BUCKET="nibras-books-private"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Payment Gateways
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

